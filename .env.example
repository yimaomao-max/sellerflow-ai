# OpenAI-compatible API (optional — mock mode works without keys)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Public demo / Vercel: force mock AI even if a key is present (recommended for shared demos)
SELLERFLOW_FORCE_MOCK=0

# Show demo banner in the workbench when set to 1
NEXT_PUBLIC_SELLERFLOW_DEMO=0