{
  "manifest_version": 3,
  "name": "SellerFlow AI Capture",
  "version": "0.1.0",
  "description": "Capture AliExpress product pages into SellerFlow AI workbench (M1 MVP).",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": [
    "https://*.aliexpress.com/*",
    "https://www.aliexpress.com/*",
    "https://aliexpress.com/*"
  ],
  "action": {
    "default_title": "SellerFlow Capture",
    "default_popup": "popup/index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.aliexpress.com/item/*",
        "https://www.aliexpress.com/item/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}